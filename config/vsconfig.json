{
  "version": 1,
  "required_plugins": ["lsmas", "imwri"],
  "extra_plugin_dirs": ["vs-plugins"],
  "image_source_format": "RGB24",
  "output_format": "YUV420P8",
  "resampler_kernel": "Bicubic",
  "colour": {
    "matrix_s": "170m",
    "heuristic": { "height_threshold": 720, "hd_matrix": 1, "sd_matrix": 6 }
  },
  "core": { "num_threads": 0, "max_cache_size_mb": 0 }
}
