{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhodesepass.local/schemas/vsconfig.schema.json",
  "title": "VSConfig",
  "type": "object",
  "required": ["version", "required_plugins", "output_format", "resampler_kernel", "colour"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "required_plugins": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "extra_plugin_dirs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "image_source_format": { "type": "string", "minLength": 1 },
    "output_format": { "type": "string", "minLength": 1 },
    "resampler_kernel": { "type": "string", "minLength": 1 },
    "colour": {
      "type": "object",
      "required": ["matrix_s", "heuristic"],
      "additionalProperties": true,
      "properties": {
        "matrix_s": { "type": "string", "minLength": 1 },
        "heuristic": {
          "type": "object",
          "required": ["height_threshold", "hd_matrix", "sd_matrix"],
          "additionalProperties": true,
          "properties": {
            "height_threshold": { "type": "integer", "minimum": 1 },
            "hd_matrix": { "type": "integer" },
            "sd_matrix": { "type": "integer" }
          }
        }
      }
    }
  }
}
